# Node — must exclude at every depth (pnpm nested symlinks break BuildKit on Windows)
node_modules
**/node_modules
**/node_modules/**
**/.pnpm-store
**/.pnpm-store/**
npm-debug.log

# Frontend host install / build artefacts (not needed in Python MCP image)
