frontend/cat-admin-frontend/playwright-report
frontend/cat-admin-frontend/test-results
frontend/cat-admin-frontend/coverage
whiskers-vscode/node_modules
whiskers-vscode/node_modules/**
whiskers-vscode/out

# Quarantined/legacy plugins — not loaded at runtime, keep out of the build context
