# ==============================================================================
# Whiskers Agent MCP Server - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL connection string for OAuth client/token persistence.
# Format: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=postgresql+psycopg://whiskers:whiskers@postgres:5432/whiskers_agent_mcp
MASTER_KEY=your-key

# ------------------------------------------------------------------------------
# 2. Server & Network Settings
# ------------------------------------------------------------------------------
# MCP HTTP server port (used by Docker and local HTTP mode)
MCP_PORT=10000
MCP_SERVER_URL=http://localhost:${MCP_PORT}

# CORS allowed origins for browser clients (comma-separated list of origins)
# (e.g. portfolio SPA dev, GitHub Pages, local dev, etc.)
# Include :11000 for local CatPortfolio docker compose (nginx). Vite often uses :5173.
MCP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,https://coolgunxdd.github.io,http://localhost:8080,http://127.0.0.1:8080,http://localhost:11000,http://127.0.0.1:11000

# DEV ONLY. Reflects ANY Origin with credentials — any site the browser visits can
# then make authenticated calls to this server. Leave 0 outside a local/ngrok demo.
# A wildcard MCP_CORS_ORIGINS=* does NOT enable this; the opt-in must be explicit.
MCP_CORS_RELAXED=0

# React frontend settings
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000

# Public CatPortfolio domain for resume PDF contact-header links (?j=<short_id>).
# When unset, PDF links fall back to a relative /?j=... path.
#CATPORTFOLIO_PUBLIC_DOMAIN=portfolio.example.com

# ------------------------------------------------------------------------------
# 3. Authentication & OAuth Configuration
# ------------------------------------------------------------------------------
# Default credentials if OAuth is not set up automatically
USERNAME=
PASSWORD=

# OAuth override auto-detection: "true" forces OAuth on, "false" forces it off.
# When omitted, OAuth is enabled automatically if credentials above are empty.
#OAUTH_ENABLED=true

# Redirect URI for OAuth flows. Defaults to {MCP_SERVER_URL}/oauth/plugin/whiskers_agent/callback if omitted.
OAUTH_REDIRECT_URI=

# ------------------------------------------------------------------------------
# 4. Core LLM Configuration
# ------------------------------------------------------------------------------
# LLM Configuration (required for run_graph tool)
# Choose one provider and set the corresponding API key (or CLI binary for CLI providers)
# Options: openai | anthropic | gemini | gemini-vertex | claude-cli | agy-cli | grok-cli
LLM_PROVIDER=gemini

# Graph entry mode (multi-stack runtime):
#   auto      — oneshot when core LLM is a CLI provider; else native root graph
#   oneshot   — force CLI Mode-B oneshot (requires CLI core provider)
#   root      — force native LangGraph (triage → chat|classic|specialist)
#GRAPH_MODE=auto
#CLI_PROVIDER_ONESHOT=1

# Optional: override default model
#   openai    → gpt-4o
#   anthropic → claude-sonnet
#   gemini    → gemini-2.5-flash
#LLM_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 5. Standard LLM Provider Credentials
# ------------------------------------------------------------------------------
# For standard LLM providers (uncomment and configure as needed)
#OPENAI_API_KEY=               # Your OpenAI API key here
#ANTHROPIC_API_KEY=            # Your Anthropic API key here (also used by Claude Code CLI as alternative to OAuth token)
#GOOGLE_API_KEY=               # Your Gemini API key here
#GOOGLE_VERTEX_API_KEY=        # Gemini Vertex AI Express API key (no GCP project/IAM needed)

# Local LLM nodes (LM Studio, Ollama, vLLM, etc.) via OpenAI-compatible endpoints:
#LLM_BASE_URL=http://127.0.0.1:1234/v1
#LLM_API_KEY=lm-studio

# ------------------------------------------------------------------------------
# 6. Semantic Search & Embedding Configuration
# ------------------------------------------------------------------------------
# By default, EMBED_PROVIDER inherits from LLM_PROVIDER.
# Use these overrides if you want a different embed stack than chat.
# anthropic / claude-cli → Voyage AI embeddings (never silent OpenAI fallback).
#   Set VOYAGE_API_KEY (or EMBED_API_KEY). Docs: https://platform.claude.com/docs/en/build-with-claude/embeddings
# agy-cli / grok-cli have no embeddings — set EMBED_PROVIDER=openai|gemini|voyage explicitly.
#VOYAGE_API_KEY=
#EMBED_PROVIDER=voyage
#EMBED_MODEL=voyage-4
#EMBED_DIMENSIONS=1024
#EMBED_PROVIDER=openai
#EMBED_BASE_URL=http://127.0.0.1:1234/v1
#EMBED_API_KEY=lm-studio
#EMBED_MODEL=text-embedding-embeddinggemma-300m
#EMBED_DIMENSIONS=1500
# Global vector width for ALL embedding tables (route_embeddings, content_vectors,
# unity_world_vectors, ...). Server pads/truncates model output to this size when needed.

# ------------------------------------------------------------------------------
# 7. CLI Agent Installer & Global Subprocess Settings
# ------------------------------------------------------------------------------
# Docker image installs CLI agents by default if enabled (1 = enabled, 0 = disabled)
INSTALL_CLAUDE_CODE=1
INSTALL_AGY=1
INSTALL_GROK=1

# CLI provider mapping and path setup (use with LLM_PROVIDER=claude-cli, agy-cli or grok-cli)
# Binary must be on PATH inside the process that runs Whiskers Agent (host or container).
#CLI_AGENT_PROVIDER=claude     # claude | agy | grok | generic (default driver for generic tooling)
#CLAUDE_CLI_BINARY=claude
#CLAUDE_CLI_EXTRA_ARGS=

#AGY_CLI_BINARY=agy
#AGY_CLI_EXTRA_ARGS=
#AGY_CLI_APPROVE=all           # Non-TTY approval policy for agy --headless

# CLI process constraints & overrides
#CLI_AGENT_WORKDIR=            # Default: repo root or CAT_SANDBOX_WORKDIR
#CLI_AGENT_TIMEOUT_S=300
#CLI_AGENT_MAX_CONCURRENT=2
#CLI_AGENT_MAX_PROMPT_CHARS=120000
#CLI_AGENT_MAX_OUTPUT_BYTES=524288
#CLI_AGENT_CMD=                # Generic only: e.g. my-agent --print {prompt}
#CLI_AGENT_REQUIRE_BINARY=0    # Set 1 to fail _LLM_AVAILABLE when binary missing at boot

# Headless CLI user credentials and privilege policies
# Note: Headless CLI runs as this OS user (Docker creates whiskers-claude). Parent MCP stays root.
#CLI_AGENT_USER=whiskers-claude
#CLI_AGENT_DROP_PRIVS=1        # Set 0 to keep parent identity (not recommended as root)

# ------------------------------------------------------------------------------
# 8. CLI Agent Headless Authentication & Execution Overrides
# ------------------------------------------------------------------------------
# Claude Code subscription OAuth token (preferred over keychain; alternative to interactive /login).
# Generate on a logged-in host via `claude setup-token` and paste here.
#CLAUDE_CODE_OAUTH_TOKEN=

# Grok CLI authentication (valid base64 or JSON of ~/.grok/auth.json)
#GROK_AUTH_JSON=

# Additional CLI agent execution settings
#DISABLE_AUTOUPDATER=1         # Default in Docker image; keeps CLI from self-updating
#CLAUDE_CLI_BARE=0             # --bare skips OAuth; leave unset (auto: off when OAuth token set)
#CLAUDE_CLI_SKIP_PERMISSIONS=1 # Pass --dangerously-skip-permissions (default on for non-root child)

# ------------------------------------------------------------------------------
# 9. GoapAgent Mode B CLI Auto-Injection Configuration
# ------------------------------------------------------------------------------
# When GoapAgent_run_cli_agent spawns claude, Whiskers Agent writes a temp MCP config
# pointing at this server and appends instructions/CLI_AGENT.md as system prompt.
#GOAP_AGENT_AUTO_MCP=1         # Default on; set 0 to disable MCP config injection
#GOAP_AGENT_STRICT_MCP=1       # Pass --strict-mcp-config (default on with auto inject)
#GOAP_AGENT_MCP_URL=           # Full MCP endpoint (default: {MCP_SERVER_URL}/mcp)
#GOAP_AGENT_MCP_TOKEN=         # Static Bearer for child MCP calls (else mint / inherit)
#GOAP_AGENT_MCP_CONFIG=        # Pre-made mcp JSON path (skips auto-write when set)
#GOAP_AGENT_INSTRUCTIONS_PATH= # Override package instructions/CLI_AGENT.md
#GOAP_AGENT_MCP_SERVER_NAME=whiskers-goap
#GOAP_AGENT_OAUTH_CLIENT_ID=goap-agent-cli

# Logging settings for headless CLI run processes (lifecycle + stdout/stderr + run.json)
# Logs saved to GOAP_AGENT_LOG_DIR/<run_id>/ (process.log, events.jsonl, stdout.txt, stderr.txt)
#GOAP_AGENT_LOG=1              # Default on; set 0 to disable file run logs
#GOAP_AGENT_LOG_DIR=           # Default: <workdir>/logs/goap_agent or repo logs/goap_agent
#GOAP_AGENT_LOG_STREAMS=1      # Mirror each stdout/stderr line to Python logger (default on)
#GOAP_AGENT_LOG_PROMPT=0       # Set 1 to write full prompt.txt (default: truncated preview)
#GOAP_AGENT_CLI_VERBOSE=1      # Pass claude --verbose so internal steps hit stderr (default on)
#CLAUDE_CLI_VERBOSE=           # Optional override for Claude driver only

# ------------------------------------------------------------------------------
# 10. Web Search Integrations
# ------------------------------------------------------------------------------
# Web Search (search_plugin) — Tavily preferred, Brave fallback
#TAVILY_API_KEY=tvly-...       # 1k free/mo, agent-optimized
#BRAVE_SEARCH_API_KEY=BSA...   # $3 per 2k queries/mo

# ------------------------------------------------------------------------------
# 11. MinIO Object Storage
# ------------------------------------------------------------------------------
# Used by job_search_plugin (resume/cover PDFs) and GOAP artifact offload
# (large step_results → short_id refs; download via session-gated REST / MCP tools).
# Compose service defaults match the values below when MinIO is started with the stack.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
# Default bucket for job-search PDFs (utils/minio_client.DEFAULT_BUCKET)
MINIO_BUCKET=job-search-resumes
# Bucket for GOAP run_graph artifact offload (utils/artifact_store.ARTIFACT_BUCKET)
ARTIFACT_BUCKET=whiskers-artifacts
# Root credentials for the MinIO container itself (docker-compose minio service)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ------------------------------------------------------------------------------
# 12. pgAdmin Configuration
# ------------------------------------------------------------------------------
# pgAdmin 4 panel settings (accessible at http://localhost:5050)
PGADMIN_EMAIL=admin@whiskers-agent.dev
PGADMIN_PASSWORD=admin
