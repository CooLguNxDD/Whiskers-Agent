    "inputSchema": {
      "properties": {
        "sourceId": {
          "title": "Sourceid",
          "type": "string",
          "description": "The bare source id WITHOUT the \"sources/\" prefix — the path template already supplies it (a full path like \"sources/github/owner/repo\" here 404s as \"sources/sources/...\"). Example: \"github/CooLguNxDD/Whiskers-Agent-Full\"."
