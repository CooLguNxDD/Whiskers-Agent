{
  "name": "cat_fleet_chat_plugin",
  "version": "0.6.0",
  "tier": "free",
  "description": "Proxy MCP tools for Cat Fleet Chat: channels, tasks, attachments, event waits, v2 mail, feed, knowledge, proposals, evolve state, topic pub/sub, durable consumers, chat relays (Discord/Slack/Telegram) and the control-plane audit log.",
  "author": "Whiskers Agent",
  "requires": [],
  "capabilities": [
    "fleet_post_message",
    "fleet_get_messages",
    "fleet_wait_for_mentions",
    "fleet_list_channels",
    "fleet_create_channel",
    "fleet_create_task",
    "fleet_claim_task",
    "fleet_update_task_status",
    "fleet_list_tasks",
    "fleet_list_agents",
    "fleet_wait_for_events",
    "fleet_archive_channel",
    "fleet_unarchive_channel",
    "fleet_attach_file",
    "fleet_get_attachment",
    "fleet_set_channel_state",
    "fleet_mail_send",
    "fleet_mail_list",
    "fleet_mail_read",
    "fleet_mail_ack",
    "fleet_mail_counts",
    "fleet_publish",
    "fleet_subscribe",
    "fleet_unsubscribe",
    "fleet_list_subscriptions",
    "fleet_list_publications",
    "fleet_feed_post",
    "fleet_feed_reply",
    "fleet_feed_repost",
    "fleet_feed_react",
    "fleet_feed_unreact",
    "fleet_feed_timeline",
    "fleet_feed_thread",
    "fleet_knowledge_add",
    "fleet_knowledge_list",
    "fleet_knowledge_set_status",
    "fleet_knowledge_topics",
    "fleet_list_proposals",
    "fleet_get_proposal",
    "fleet_create_proposal",
    "fleet_update_proposal",
    "fleet_get_evolve_state",
    "fleet_consumer_list",
    "fleet_consumer_create",
    "fleet_consumer_update",
    "fleet_consumer_delete",
    "fleet_consumer_wait",
    "fleet_consumer_ack",
    "fleet_consumer_seek",
    "fleet_audit_list",
    "fleet_relay_list",
    "fleet_relay_get",
    "fleet_relay_update",
    "fleet_relay_bind",
    "fleet_relay_unbind",
    "fleet_relay_route_add",
    "fleet_relay_route_update",
    "fleet_relay_route_seek",
    "fleet_relay_route_remove"
  ],
  "scopes": [
    {
      "token": "plugin:cat_fleet_chat_plugin",
      "description": "Full access to fleet chat tools"
    },
    {
      "token": "group:cat_fleet_chat_plugin:read",
      "description": "Read messages, channels, tasks, attachments, mail/counts, feed/threads, knowledge/topics, proposals, evolve state, topic subscriptions and publication history, durable consumers, chat relays and the audit log"
    },
    {
      "token": "group:cat_fleet_chat_plugin:write",
      "description": "Post messages/attachments, manage tasks/channels, send/read/ack mail, post/reply/repost/react on feed, record knowledge, manage proposals, publish to topics and manage subscriptions, create/ack/seek durable consumers"
    },
    {
      "token": "group:cat_fleet_chat_plugin:wait",
      "description": "Park a turn waiting for a mention, event or durable-consumer delivery"
    },
    {
      "token": "group:cat_fleet_chat_plugin:admin",
      "description": "Change chat relays: config, bindings (platform channel to hub channel) and routes (events delivered to Discord/Slack/Telegram)"
    }
  ],
  "gate": {
    "core": []
  },
  "skills": [
    "skills/agent-fleet-chat/SKILL.md"
  ],
  "settings": {
    "hub_url": "${CAT_FLEET_HUB_URL}",
    "request_timeout_s": 10,
    "wait_timeout_default_s": 60,
    "wait_timeout_max_s": 300,
    "default_channel": "fleet",
    "attachment_bucket": "cat-fleet-attachments",
    "attachment_max_bytes": 10485760,
    "attachment_inline_max_bytes": 262144,
    "attachment_url_ttl_s": 3600
  }
}
