{
  "_comment": "Embedding model profiles for semantic search and RAG. API keys live in .env / vault — not in this file. Copy to embedding_config.json and set active to a profile key under models.",

  "active": "openai",
  "models": {
    "lmstudio": {
      "enabled": false,
      "provider": "openai",
      "model": "text-embedding-qwen3-embedding-0.6b",
      "dimensions": 1024,
      "_comment": "Qwen3-Embedding is asymmetric: queries carry an English instruction prefix, documents are embedded as raw text with no prefix.",
      "query_prefix": "Instruct: Given a search query, retrieve relevant passages that answer the query\nQuery:{text}",
      "document_prefix": "{text}"
    },
    "gemma": {
      "enabled": true,
      "provider": "openai",
      "model": "embeddinggemma:300m",
      "modalities": ["text"],
      "dimensions": 768,
      "query_prefix": "task: search result | query: {text}",
      "document_prefix": "title: {title} | text: {text}",
      "default_title": "none"
    },
    "gemma_multimodal": {
      "enabled": false,
      "provider": "gemma-multimodal",
      "model": "gemma-embedding-2-multimodal",
      "dimensions": null,
      "base_url": null,
      "modalities": ["text", "image/png", "image/jpeg", "audio/wav"],
      "adapter_protocol": "litellm-content-parts-v1",
      "batch_size": 8,
      "max_concurrency": 2,
      "max_media_bytes": 10000000,
      "timeout_seconds": 60,
      "query_prefix": "{text}",
      "document_prefix": "{text}",
      "_comment": "Opt-in adapter route alias, NOT embeddinggemma:300m. Set verified model dimensions and gateway base_url before use; see docs/gemma-multimodal-embedding.md. No upstream multimodal Gemma deployment is assumed."
    },
    "gemini": {
      "enabled": false,
      "provider": "gemini",
      "model": "gemini-embedding-001",
      "dimensions": 3072,
      "query_prefix": "task: search result | query: {text}",
      "document_prefix": "title: {title} | text: {text}",
      "default_title": "none"
    },
    "openai": {
      "enabled": true,
      "provider": "openai",
      "model": "text-embedding-3-small",
      "dimensions": 1536,
      "query_prefix": "{text}",
      "document_prefix": "{text}"
    },
    "voyage": {
      "enabled": false,
      "provider": "voyage",
      "model": "voyage-4",
      "dimensions": 1024,
      "query_prefix": "{text}",
      "document_prefix": "{text}"
    },
    "jina": {
      "enabled": false,
      "provider": "openai",
      "model": "jina-embeddings-v3",
      "dimensions": 1024,
      "query_prefix": "Query: {text}",
      "document_prefix": "Document: {text}"
    },
    "nomic": {
      "enabled": false,
      "provider": "openai",
      "model": "nomic-embed-text-v1.5",
      "dimensions": 768,
      "query_prefix": "search_query: {text}",
      "document_prefix": "search_document: {text}"
    }
  }
}